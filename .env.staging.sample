# Copy this file to .env only when running against a staging database clone.
# Do not use the production database URL here.

DATABASE_URL="mysql+pymysql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:STAGING_PORT/STAGING_DB?ssl_disabled=False"

# Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL="http://127.0.0.1:5173"

# SMTP settings for admin password reset email.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="yourshop@gmail.com"
SMTP_PASSWORD="YOUR_16_CHARACTER_APP_PASSWORD"
SMTP_FROM="yourshop@gmail.com"
SMTP_FROM_NAME="GFmoter"
SMTP_USE_TLS=true
