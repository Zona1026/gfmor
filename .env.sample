# Copy this file to .env for local development.
# Never put production credentials in committed files.

# Local or staging database URL.
# Example:
# DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME?ssl_disabled=False"
DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME?ssl_disabled=False"

# Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL="http://127.0.0.1:5173"

# SMTP settings for admin password reset email.
# For Gmail, SMTP_PASSWORD should be a Google App Password, not your normal Google password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="yourshop@gmail.com"
SMTP_PASSWORD="YOUR_16_CHARACTER_APP_PASSWORD"
SMTP_FROM="yourshop@gmail.com"
SMTP_FROM_NAME="GFmoter"
SMTP_USE_TLS=true
