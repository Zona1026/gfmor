# Copy this file to .env for local development.
# Never put production credentials in committed files.

# Local or staging database URL.
# Example:
# DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME?ssl_disabled=False"
DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME?ssl_disabled=False"

# Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL="http://127.0.0.1:5173"
